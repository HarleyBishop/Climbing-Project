# Copy this file to .env and fill in values for local development.
# .env is gitignored — never commit it.

# Required
SECRET_KEY=your-local-secret-key-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here

# Leave DATABASE_URL unset locally — Django will use SQLite automatically.
# Only set this in production (your host sets it automatically for Postgres).
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional overrides (these default to local-friendly values if unset)
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
